<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2025-06-19-create-swim-set-table" author="AndyGabler">
        <createTable tableName="swim_set">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="rep_length" type="smallint">
                <constraints nullable="false" />
            </column>
            <column name="rep_count" type="tinyint">
                <constraints nullable="false" />
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="description" type="varchar(1333)">
                <constraints nullable="false" />
            </column>
        </createTable>
        <createIndex tableName="swim_set" unique="true" indexName="swim_set_name_search_index">
            <column name="name"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>